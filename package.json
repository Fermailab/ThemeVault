{
  "name": "themevault",
  "version": "1.0.0",
  "description": "Browser-agnostic extension providing custom themes, layout tweaks, and theme vault management for any Invision Community forum",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "build": "node scripts/build.js --target=all",
    "build:chrome": "node scripts/build.js --target=chrome",
    "build:firefox": "node scripts/build.js --target=firefox",
    "package": "node scripts/package.js"
  },
  "keywords": [
    "invision-community",
    "invision-power-board",
    "ipb",
    "ips4",
    "ips5",
    "browser-extension",
    "webextension",
    "manifest-v3",
    "dark-mode",
    "themes",
    "gplv3"
  ]
}
